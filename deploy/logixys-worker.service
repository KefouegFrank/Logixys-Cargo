# systemd unit for the queue worker. Nothing in the app sends mail without this running.
#   sudo cp deploy/logixys-worker.service /etc/systemd/system/
#   sudo systemctl enable --now logixys-worker
[Unit]
Description=Logixys Cargo queue worker
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
Restart=always
RestartSec=5
# --max-time recycles the process hourly so a long-lived worker can't hold stale code.
ExecStart=/usr/bin/php /var/www/logixys-cargo/artisan queue:work --queue=default --sleep=3 --tries=3 --max-time=3600
ExecStop=/bin/kill -s TERM $MAINPID

[Install]
WantedBy=multi-user.target
